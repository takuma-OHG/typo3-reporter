{
    "name": "takuma/typo3-reporter",
    "description": "Meldet TYPO3-, PHP-Version und installierte Pakete an den takuma manager.",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "typo3/cms-core": "^12.4|^13.4|^14.0",
        "typo3/cms-frontend": "^12.4|^13.4|^14.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^2.0",
        "typo3/testing-framework": "^8.2|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Takuma\\Typo3Reporter\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Takuma\\Typo3Reporter\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "takuma_reporter",
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse",
        "test:unit": "phpunit",
        "test": ["@test:lint", "@test:types", "@test:unit"]
    },
    "config": {
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "minimum-stability": "stable"
}
